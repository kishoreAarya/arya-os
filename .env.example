# ==========================================================
# Project Arya OS — Environment Configuration Template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ==========================================================

# --- App ---
APP_NAME=arya-os
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- API Security & Authentication (Task 8) ---
ARYA_API_KEY=change_me_in_production_secret_key
API_AUTH_ENABLED=true        # true = enforced; false = development bypass (ignored in production)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:4173,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=true

# --- Server & Process Configuration (Task 12) ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
UVICORN_WORKERS=1            # Single worker required due to internal APScheduler maintenance tasks
UVICORN_TIMEOUT_KEEP_ALIVE=65
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=60
AUTO_RUN_MIGRATIONS=true     # Automatically runs 'alembic upgrade head' on container start

# --- Database ---
POSTGRES_USER=arya
POSTGRES_PASSWORD=change_me
POSTGRES_DB=arya_os
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://arya:change_me@localhost:5432/arya_os
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- n8n (workflow orchestrator, called from n8n -> this backend) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_HOST_PORT=5678

# --- Provider API Keys (fill in as you wire up each provider) ---
GEMINI_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RUNPOD_API_KEY=
FAL_API_KEY=
FAL_KEY=
TOGETHER_API_KEY=
REPLICATE_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5
DEFAULT_VOICE_PROVIDER=elevenlabs
DEFAULT_VIDEO_PROVIDER=kling

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backend server ---
BACKEND_PORT=8000

# --- Global tunables ---
QUALITY_THRESHOLD=70.0
MAX_RETRY_ATTEMPTS=3
API_TIMEOUT_SECONDS=60
IMAGE_RESOLUTION=1024x1024
VIDEO_FPS=30
MAX_COST_PER_VIDEO_USD=5.00
DEFAULT_LLM_MODEL=deepseek/deepseek-chat

# --- Feature flags ---
ENABLE_AUTONOMOUS_PUBLISHING=false
ENABLE_LEARNING_LOOP=true
ENABLE_EXPERIMENTAL_THUMBNAIL_AGENT=false
ENABLE_NEW_IMAGE_MODEL=false
ENABLE_NEW_VALIDATOR=false
ENABLE_BACKGROUND_SCHEDULER=true
ENABLE_LIVE_PROVIDER_EXECUTION=false  # Stage 25 live provider execution gate (must remain false; fail-closed default)

# --- Storage ---
STORAGE_BACKEND=local             # local | s3 | r2
STORAGE_LOCAL_PATH=./data/storage
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- YouTube / Platform Settings ---
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# --- Postiz Publishing Settings ---
POSTIZ_BASE_URL=http://localhost:4007
POSTIZ_API_KEY=
POSTIZ_TIMEOUT_SECONDS=30.0
POSTIZ_DEFAULT_INTEGRATION_ID=

# --- Reddit Research Settings ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=AryaOS-Research/1.0 (Content Factory Assistant)
REDDIT_TIMEOUT_SECONDS=10.0

# --- Workflow Lease & Durability ---
WORKFLOW_LEASE_TIMEOUT_SECONDS=300
WORKFLOW_HEARTBEAT_INTERVAL_SECONDS=15
ENABLE_WORKFLOW_AUTO_RECOVERY=false
