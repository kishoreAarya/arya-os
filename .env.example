# ==========================================================
# Project Arya OS — Environment Configuration
# Copy this file to .env and fill in real values.
# Never commit .env to version control.
# ==========================================================

# --- App ---
APP_NAME=arya-os
APP_ENV=development          # development | staging | production
DEBUG=true
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# --- Database ---
POSTGRES_USER=arya
POSTGRES_PASSWORD=change_me
POSTGRES_DB=arya_os
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://arya:change_me@postgres:5432/arya_os

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# --- n8n (workflow orchestrator, called from n8n -> this backend) ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me
N8N_HOST_PORT=5678

# --- Provider API Keys (fill in as you wire up each provider) ---
OPENROUTER_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
RUNPOD_API_KEY=
FAL_API_KEY=
REPLICATE_API_KEY=

# --- Notifications ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Backend server ---
BACKEND_PORT=8000

# --- Global tunables (Hardening Pass #3) ---
QUALITY_THRESHOLD=70.0
MAX_RETRY_ATTEMPTS=3
API_TIMEOUT_SECONDS=60
IMAGE_RESOLUTION=1024x1024
VIDEO_FPS=30
MAX_COST_PER_VIDEO_USD=5.00
DEFAULT_LLM_MODEL=deepseek/deepseek-chat

# --- Feature flags (env-level defaults — override at runtime via
# PUT /feature-flags/{name}, which takes precedence once set) ---
ENABLE_AUTONOMOUS_PUBLISHING=false
ENABLE_LEARNING_LOOP=true
ENABLE_EXPERIMENTAL_THUMBNAIL_AGENT=false
ENABLE_NEW_IMAGE_MODEL=false
ENABLE_NEW_VALIDATOR=false
ENABLE_BACKGROUND_SCHEDULER=true

# --- Storage ---
STORAGE_BACKEND=local             # local | s3 | r2
STORAGE_LOCAL_PATH=./data/storage
STORAGE_BUCKET=
STORAGE_ENDPOINT_URL=             # set for Cloudflare R2, leave blank for AWS S3
STORAGE_REGION=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=
