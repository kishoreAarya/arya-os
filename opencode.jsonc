{
  "$schema": "https://opencode.ai/config.json",

  "permission": {
    "edit": "allow",
    "write": "allow",
    "read": "allow",

    "bash": {
      "*": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git branch*": "ask",
      "git switch*": "ask",
      "git add*": "ask",
      "git commit*": "ask",
      "git push*": "deny",
      "git reset*": "deny",
      "git clean*": "deny",
      "rm *": "deny"
    },

    "webfetch": "ask",
    "external_directory": "deny"
  }
}
